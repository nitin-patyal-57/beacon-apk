<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FF1A1A2E">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scanning..."
        android:textColor="#FF4CAF50"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_beacon_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No beacon detected"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_beacon_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Waiting for beacon signal..."
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/widget_beacon_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

</LinearLayout>
